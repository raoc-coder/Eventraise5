# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://supabase-indigo-lamp.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Sprint 4.5 — notify-outbid (ADR-0008): Next.js does not read these; store as Supabase Vault secrets (SQL editor):
#   select vault.create_secret('https://<project-ref>.supabase.co/functions/v1/notify-outbid', 'notify_outbid_edge_url');
#   select vault.create_secret('<same value as SUPABASE_SERVICE_ROLE_KEY>', 'notify_outbid_service_role');
# Edge Function secrets (Dashboard → Edge Functions → notify-outbid): inherit SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.
# Optional: NOTIFICATIONS_KILL_SWITCH=true on the function to acknowledge invokes without enqueueing deliveries.

# PayPal Configuration (primary processor — ADR-0016)
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_ENVIRONMENT=sandbox

# Twilio — Verify (S0.3a auth) + Messaging (outbid SMS, donation share texts)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_VERIFY_SERVICE_SID=your_twilio_verify_service_sid
# For Programmable Messaging (S0.3b / Sprint 4): use Messaging Service and/or a From number
TWILIO_MESSAGING_SERVICE_SID=your_twilio_messaging_service_sid
# TWILIO_FROM_NUMBER=+15551234567

# Web Push (S0.6 — ADR-0003). Generate: npm run generate:vapid -- --subject mailto:admin@eventraisehub.com
VAPID_SUBJECT=mailto:admin@eventraisehub.com
VAPID_PUBLIC_KEY=your_vapid_public_key
VAPID_PRIVATE_KEY=your_vapid_private_key
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your_vapid_public_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
# For production, set this to your Vercel domain: https://your-app.vercel.app
NEXT_PUBLIC_APP_VERSION=1.0.0

# Owner-only admin access (comma-separated; set at least OWNER_USER_IDS in production)
# Find your Supabase auth user id from the dashboard/users table.
OWNER_USER_IDS=your_owner_user_uuid
# Optional fallback allowlist by email
OWNER_ADMIN_EMAILS=you@example.com

# Observability Configuration
# Sentry Error Monitoring
NEXT_PUBLIC_SENTRY_DSN=your_sentry_dsn
SENTRY_ORG=your_sentry_org
SENTRY_PROJECT=your_sentry_project
SENTRY_AUTH_TOKEN=your_sentry_auth_token

# PostHog Analytics
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Meta Pixel (Facebook Pixel)
NEXT_PUBLIC_META_PIXEL_ID=your_meta_pixel_id

# Monitoring & Alerts
MONITORING_EMAIL=admin@yourdomain.com
ALERT_WEBHOOK_URL=your_slack_or_discord_webhook_url

# Vercel Cron (Sprint 3 lot-close sweep — `vercel.json` → `/api/cron/sweep-auction-lots`).
# Hobby: at most one cron/day — schedule in vercel.json is daily. Pro: you may use e.g. `*/5 * * * *` for ~5 min sweeps.
CRON_SECRET=generate_a_long_random_string

# Auctions (Sprint 3) — optional: allow register without vault (dev only)
# AUCTION_ALLOW_PENDING_REGISTRATION=true
